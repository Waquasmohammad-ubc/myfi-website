---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "About MyFi | Renewal readiness for mortgage brokerages";
const description = "MyFi helps independent mortgage brokerages keep clients at renewal — a branded readiness session for clients and a two-page brief for agents.";
---

<BaseLayout title={title} description={description} canonicalUrl="/about">
  <!-- Hero Section -->
  <section class="about-hero">
    <div class="hero-bg">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
    </div>
    <div class="container">
      <p class="eyebrow animate-fade-up">About Us</p>
      <h1 class="animate-fade-up delay-1">Renewal is where relationships are <span class="text-gradient">won or lost</span></h1>
      <p class="hero-subtitle animate-fade-up delay-2">MyFi helps independent mortgage brokerages turn the renewal moment into retention — with prepared clients and a brief the agent reads before the call.</p>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="section">
    <div class="container">
      <div class="mission-grid">
        <div class="mission-content scroll-slide-left">
          <p class="eyebrow">Our Mission</p>
          <h2>Keep the client with the broker — not the bank.</h2>
          <p>At renewal, most clients drift to the bank's one-click renewal, because no one showed them what else was possible. Brokerages lose relationships they spent years building, right at the moment that matters most.</p>
          <p>MyFi changes that. About 150 days before maturity, the client works through their real options in a branded 15-minute session, and the assigned agent gets a two-page brief before the call — prepared clients, kept in your channel.</p>
        </div>
        <div class="mission-visual scroll-slide-right">
          <div class="value-card purple">
            <div class="value-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            <h3>Options, not advice</h3>
            <p>It maps choices and trade-offs — never a recommended lender or product.</p>
          </div>
          <div class="value-card green">
            <div class="value-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3>Client-owned record</h3>
            <p>Hosted in Canada. The client keeps their record.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why We Built MyFi Section -->
  <section class="section section-gradient">
    <div class="container">
      <div class="section-header center scroll-fade-up">
        <p class="eyebrow">Our Story</p>
        <h2>Why We Built <span class="text-gradient">MyFi</span></h2>
      </div>

      <div class="story-grid">
        <div class="story-card scroll-fade-up">
          <div class="story-number">01</div>
          <h3>The Problem We Saw</h3>
          <p>Canada is in the largest mortgage renewal wave on record. Yet at renewal the bank offers a frictionless one-click renew, and the broker who set up the mortgage is nowhere in the conversation.</p>
          <p>Brokerages lose hard-won clients at exactly the moment they could compete.</p>
        </div>

        <div class="story-card scroll-fade-up">
          <div class="story-number">02</div>
          <h3>The Solution We Created</h3>
          <p>A white-labeled renewal-readiness session: the client confirms what's changed and sees three to five costed options on their phone. It maps trade-offs and never recommends.</p>
          <p>The assigned agent receives a two-page brief before the call — every number from a deterministic engine, so the conversation starts prepared.</p>
        </div>

        <div class="story-card scroll-fade-up">
          <div class="story-number">03</div>
          <h3>Built for Canada</h3>
          <p>MyFi is built from the ground up for the Canadian mortgage market and hosted in Canada.</p>
          <p>It understands renewal timing, the stress test and straight-switch rules, insured vs uninsured, and the compliance line that keeps option-mapping on the right side of licensing.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="section">
    <div class="container">
      <div class="section-header center scroll-fade-up">
        <p class="eyebrow">Our Values</p>
        <h2>The principles that guide everything we do.</h2>
      </div>

      <div class="values-grid">
        <div class="value-item scroll-fade-up">
          <div class="value-num">01</div>
          <h3>Client-owned context</h3>
          <p>The client owns their decision record — portable and revocable.</p>
        </div>
        <div class="value-item scroll-fade-up">
          <div class="value-num">02</div>
          <h3>Map, don't recommend</h3>
          <p>We surface options and trade-offs; the licensed agent gives the advice.</p>
        </div>
        <div class="value-item scroll-fade-up">
          <div class="value-num">03</div>
          <h3>Privacy</h3>
          <p>Client data is sensitive. Hosted in Canada, shared only with consent, never sold.</p>
        </div>
        <div class="value-item scroll-fade-up">
          <div class="value-num">04</div>
          <h3>Every number verified</h3>
          <p>Figures come from a deterministic engine — accurate, and in plain language.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="cta-bg">
      <div class="cta-blob cta-blob-1"></div>
      <div class="cta-blob cta-blob-2"></div>
    </div>
    <div class="container">
      <div class="cta-content scroll-fade-up">
        <h2>Bring MyFi to <span class="text-gradient-light">your brokerage</span></h2>
        <p>We're running a small pilot with independent brokerages. Let's talk.</p>
        <a href="mailto:connect@my-fi.ca?subject=MyFi%20pilot%20for%20our%20brokerage" class="btn btn-white btn-lg">
          <span>Get in touch</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .about-hero {
    padding: calc(80px + var(--space-16)) 0 var(--space-16);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
  }

  .blob-1 {
    width: 400px;
    height: 400px;
    background: var(--purple-200);
    top: -100px;
    right: -100px;
    opacity: 0.4;
  }

  .blob-2 {
    width: 300px;
    height: 300px;
    background: var(--green-200);
    bottom: -50px;
    left: -50px;
    opacity: 0.3;
  }

  .about-hero .container {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--purple-600);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
  }

  .about-hero h1 {
    max-width: 700px;
    margin: 0 auto var(--space-6);
  }

  .text-gradient {
    background: linear-gradient(135deg, var(--purple-600), var(--green-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--gray-600);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Mission */
  .mission-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (max-width: 900px) {
    .mission-grid {
      grid-template-columns: 1fr;
    }
  }

  .mission-content h2 {
    font-size: 1.75rem;
    margin-bottom: var(--space-6);
  }

  .mission-content p {
    margin-bottom: var(--space-4);
    line-height: 1.8;
  }

  .mission-visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .value-card {
    padding: var(--space-6);
    border-radius: 16px;
    transition: transform 0.3s ease;
  }

  .value-card:hover {
    transform: translateY(-4px);
  }

  .value-card.purple {
    background: linear-gradient(135deg, var(--purple-500), var(--purple-600));
    color: var(--white);
  }

  .value-card.green {
    background: linear-gradient(135deg, var(--green-500), var(--green-600));
    color: var(--white);
  }

  .value-icon {
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .value-card h3 {
    color: var(--white);
    margin-bottom: var(--space-2);
  }

  .value-card p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9375rem;
    margin: 0;
  }

  /* Section Header */
  .section-header {
    margin-bottom: var(--space-12);
  }

  .section-header.center {
    text-align: center;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-gradient {
    background: linear-gradient(180deg, var(--purple-50) 0%, var(--white) 100%);
  }

  /* Story */
  .story-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
  }

  .story-card {
    background: var(--white);
    padding: var(--space-6);
    border-radius: 16px;
    border: 1px solid var(--gray-200);
    transition: all 0.3s ease;
  }

  .story-card:hover {
    border-color: var(--purple-200);
    box-shadow: 0 8px 30px rgba(147, 51, 234, 0.1);
  }

  .story-number {
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--purple-500), var(--green-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-4);
  }

  .story-card h3 {
    margin-bottom: var(--space-4);
  }

  .story-card p {
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-bottom: var(--space-3);
  }

  .story-card p:last-child {
    margin-bottom: 0;
  }

  /* Values */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 900px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .values-grid {
      grid-template-columns: 1fr;
    }
  }

  .value-item {
    text-align: center;
    padding: var(--space-6);
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: 16px;
    transition: all 0.3s ease;
  }

  .value-item:hover {
    border-color: var(--purple-200);
    transform: translateY(-4px);
  }

  .value-num {
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--purple-500), var(--green-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-4);
  }

  .value-item h3 {
    margin-bottom: var(--space-3);
  }

  .value-item p {
    font-size: 0.9375rem;
    color: var(--gray-600);
  }

  /* CTA */
  .cta-section {
    background: linear-gradient(135deg, var(--purple-600), var(--purple-700));
    padding: var(--space-20) 0;
    position: relative;
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
  }

  .cta-blob-1 {
    width: 300px;
    height: 300px;
    background: var(--purple-400);
    top: -100px;
    left: -100px;
    opacity: 0.3;
  }

  .cta-blob-2 {
    width: 200px;
    height: 200px;
    background: var(--green-400);
    bottom: -50px;
    right: -50px;
    opacity: 0.2;
  }

  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .cta-content h2 {
    color: var(--white);
    margin-bottom: var(--space-4);
  }

  .text-gradient-light {
    background: linear-gradient(135deg, #fde68a, var(--green-400));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cta-content p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.125rem;
    margin-bottom: var(--space-8);
  }

  .btn-white {
    background: var(--white);
    color: var(--purple-700);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .btn-white:hover {
    background: var(--gray-100);
    transform: translateY(-2px);
  }

  .btn-white svg {
    transition: transform 0.2s ease;
  }

  .btn-white:hover svg {
    transform: translateX(4px);
  }

  /* Animations */
  .animate-fade-up {
    opacity: 0;
    animation: fadeInUp 0.7s ease-out forwards;
  }

  .delay-1 { animation-delay: 0.1s; }
  .delay-2 { animation-delay: 0.2s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
