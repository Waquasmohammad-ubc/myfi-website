---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "MyFi | Turn every mortgage renewal into a retained client";
const description = "MyFi gives a brokerage's clients a 15-minute renewal-readiness session on their phone, then hands the agent a two-page brief before the call. Maps options, never recommends, every number verified. Hosted in Canada.";
---

<BaseLayout title={title} description={description} canonicalUrl="/">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
      <div class="grid-pattern"></div>
    </div>

    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <p class="hero-eyebrow animate-fade-up">For mortgage brokerages</p>
          <h1 class="animate-fade-up delay-1">Turn every renewal into <span class="text-gradient">a retained client.</span></h1>
          <p class="hero-subtitle animate-fade-up delay-2">
            MyFi gives your clients a 15-minute renewal-readiness session on their phone, then hands the agent a two-page brief before the call. Prepared clients, fewer lost to the bank.
          </p>
          <div class="hero-cta animate-fade-up delay-3">
            <a href="mailto:connect@my-fi.ca?subject=MyFi%20for%20our%20brokerage" class="btn btn-primary btn-lg">
              <span>Get in touch</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="#how-it-works" class="btn btn-secondary btn-lg">See How It Works</a>
          </div>
        </div>

        <div class="hero-demo animate-fade-up delay-4">
          <div class="demo-window">
            <div class="demo-header">
              <div class="demo-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="demo-title">Renewal Readiness</span>
            </div>
            <div class="demo-content">
              <div class="chat-flow">
                <div class="msg msg-bot msg-1">
                  <div class="msg-avatar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                  </div>
                  <div class="msg-bubble">Your mortgage renews in ~150 days. Want to see your real options?</div>
                </div>
                <div class="msg msg-user msg-2">
                  <div class="msg-bubble">Yes — what could I switch to?</div>
                </div>
                <div class="msg msg-bot msg-3">
                  <div class="msg-avatar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                  </div>
                  <div class="msg-bubble">Here are your options, mapped — every number verified, no recommendation.</div>
                </div>
                <div class="msg msg-bot msg-4">
                  <div class="msg-avatar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                  </div>
                  <div class="msg-card">
                    <div class="card-title">Renewal options</div>
                    <div class="card-stats">
                      <div class="stat">
                        <span class="stat-value">$3,073</span>
                        <span class="stat-label">Best-fit payment/mo</span>
                      </div>
                      <div class="stat">
                        <span class="stat-value">5 options</span>
                        <span class="stat-label">Mapped &amp; costed</span>
                      </div>
                    </div>
                    <div class="card-progress">
                      <div class="progress-bar">
                        <div class="progress-fill"></div>
                      </div>
                      <span class="progress-text">Brief ready for the agent</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="demo-float demo-float-1">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <div class="demo-float demo-float-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3v18h18"/>
              <path d="M18 17V9M13 17V5M8 17v-3"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is MyFi -->
  <section class="section">
    <div class="container">
      <div class="section-header center scroll-fade-up">
        <p class="eyebrow">What Is MyFi?</p>
        <h2>The bank makes renewal one click. <span class="text-gradient">MyFi makes you the reason they stay.</span></h2>
        <p class="section-desc">
          A white-labeled renewal-readiness session for your clients, and a two-page brief for your agent. It maps options, never recommends, and every number is verified.
        </p>
      </div>

      <div class="features-grid">
        <div class="feature-card scroll-fade-up">
          <div class="feature-icon purple">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3>Under your brand</h3>
          <p>The client sees your name, your colours, your agent — never a separate product.</p>
        </div>
        <div class="feature-card scroll-fade-up">
          <div class="feature-icon green">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3>Nothing for agents to learn</h3>
          <p>Maturities go in; a finished brief comes back by email. No dashboards, no training.</p>
        </div>
        <div class="feature-card scroll-fade-up">
          <div class="feature-icon purple">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.66 0 3-4.03 3-9s-1.34-9-3-9m0 18c-1.66 0-3-4.03-3-9s1.34-9 3-9"/>
            </svg>
          </div>
          <h3>Maps options, never advises</h3>
          <p>It lays out the real choices and trade-offs — no recommended lender or product.</p>
        </div>
        <div class="feature-card scroll-fade-up">
          <div class="feature-icon green">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <h3>Every number verified</h3>
          <p>Payments and balances come from a deterministic engine — never a guess.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section section-gradient" id="how-it-works">
    <div class="container">
      <div class="section-header center scroll-fade-up">
        <p class="eyebrow">How It Works</p>
        <h2>Four steps to a <span class="text-gradient">renewal brief</span></h2>
      </div>

      <div class="steps-timeline">
        <div class="timeline-line"></div>

        <div class="step-item scroll-slide-left">
          <div class="step-marker">
            <span>1</span>
          </div>
          <div class="step-content">
            <div class="step-text">
              <h3>Invite, under your brand</h3>
              <p>~150 days before maturity, the client gets a branded invitation naming their agent. No new app to learn.</p>
              <span class="step-result">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                A branded invite the client actually opens
              </span>
            </div>
            <div class="step-visual">
              <div class="mini-demo profile-demo">
                <div class="profile-item">
                  <span class="profile-label">Maturity</span>
                  <span class="profile-value">12 Feb 2027</span>
                </div>
                <div class="profile-item">
                  <span class="profile-label">Current rate</span>
                  <span class="profile-value">2.79%</span>
                </div>
                <div class="profile-item">
                  <span class="profile-label">Agent</span>
                  <span class="profile-value">Assigned</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="step-item scroll-slide-right">
          <div class="step-marker">
            <span>2</span>
          </div>
          <div class="step-content">
            <div class="step-text">
              <h3>A 15-minute session</h3>
              <p>The client confirms what's changed, what they want, and sees three to five costed options — right on their phone.</p>
              <span class="step-result">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                Options they understand before the call
              </span>
            </div>
            <div class="step-visual">
              <div class="mini-demo question-demo">
                <div class="question-bubble">"What could I switch to?"</div>
                <div class="answer-bubble">A <strong>straight switch, variable</strong> comes to $3,073/mo — within your ceiling.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="step-item scroll-slide-left">
          <div class="step-marker">
            <span>3</span>
          </div>
          <div class="step-content">
            <div class="step-text">
              <h3>Options, mapped</h3>
              <p>Every figure comes from a deterministic engine. It maps trade-offs and flags decisions — it never recommends.</p>
              <span class="step-result">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                Trade-offs mapped, never a "best" one
              </span>
            </div>
            <div class="step-visual">
              <div class="mini-demo scenario-demo">
                <div class="scenario-chart">
                  <div class="chart-bar" style="--height: 85%"><span>Renew</span></div>
                  <div class="chart-bar active" style="--height: 62%"><span>Switch</span></div>
                  <div class="chart-bar" style="--height: 78%"><span>Refi</span></div>
                </div>
                <div class="scenario-label">Monthly payment by option</div>
              </div>
            </div>
          </div>
        </div>

        <div class="step-item scroll-slide-right">
          <div class="step-marker">
            <span>4</span>
          </div>
          <div class="step-content">
            <div class="step-text">
              <h3>The brief lands first</h3>
              <p>Your agent opens a secure two-page brief before the call. Maturities in, a finished brief out — nothing to chase.</p>
              <span class="step-result">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                Your agent walks in prepared
              </span>
            </div>
            <div class="step-visual">
              <div class="mini-demo advisor-demo">
                <div class="advisor-card">
                  <div class="advisor-avatar">RB</div>
                  <div class="advisor-info">
                    <span class="advisor-name">Renewal Brief</span>
                    <span class="advisor-title">Two pages · for the agent</span>
                  </div>
                  <span class="advisor-badge">Ready</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section" id="comparison">
    <div class="container">
      <div class="comparison-layout">
        <div class="comparison-header-content scroll-fade-up">
          <p class="eyebrow">The Difference</p>
          <h2>What Makes MyFi <span class="text-green">Different</span>?</h2>
          <p class="section-desc">Renewal is where brokerages lose clients to the bank's one-click renewal. MyFi keeps them in your channel.</p>
        </div>

        <div class="comparison-cards">
          <div class="comparison-card old scroll-slide-left">
            <div class="comparison-card-header">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
              </svg>
              <span>The bank at renewal</span>
            </div>
            <ul class="comparison-list">
              <li>One-click auto-renew</li>
              <li>No options ever shown</li>
              <li>Client never shops around</li>
              <li>Broker out of the loop</li>
              <li>Retention left to chance</li>
            </ul>
          </div>

          <div class="comparison-card new scroll-slide-right">
            <div class="comparison-card-header">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>MyFi</span>
            </div>
            <ul class="comparison-list">
              <li>Branded renewal session</li>
              <li>Options mapped, not sold</li>
              <li>Two-page agent brief</li>
              <li>Client-owned record</li>
              <li>You keep the relationship</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why This Matters -->
  <section class="section section-dark" id="features">
    <div class="container">
      <div class="matters-layout">
        <div class="matters-content scroll-fade-up">
          <p class="eyebrow light">Why This Matters</p>
          <h2>Without a renewal play, brokerages often:</h2>
          <ul class="matters-list">
            <li>
              <span class="list-icon negative">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </span>
Lose clients to the bank at renewal
            </li>
            <li>
              <span class="list-icon negative">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </span>
Find out too late to compete
            </li>
            <li>
              <span class="list-icon negative">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </span>
Spend the first call reconstructing context
            </li>
            <li>
              <span class="list-icon negative">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </span>
Leave retention to chance
            </li>
          </ul>
          <p class="matters-highlight">A prepared client and a brief in hand change the renewal conversation.</p>
          <p class="matters-tagline">Retention is won before the call.</p>
        </div>

        <div class="matters-visual scroll-scale">
          <div class="vision-card">
            <div class="vision-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 16v-4M12 8h.01"/>
              </svg>
            </div>
            <h3>The principle</h3>
            <p>Map the options. Never recommend. Every number verified.</p>
            <ul class="vision-list">
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                Options mapped, never a "best"
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                Every number from a real engine
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                The client owns their record
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                Hosted in Canada
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Built For -->
  <section class="section">
    <div class="container">
      <div class="section-header center scroll-fade-up">
        <p class="eyebrow">Who it's for</p>
        <h2>Built for independent brokerages.</h2>
      </div>

      <div class="audience-grid">
        <div class="audience-card scroll-fade-up">
          <div class="audience-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <span>Independent brokerages</span>
        </div>
        <div class="audience-card scroll-fade-up">
          <div class="audience-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <span>Mortgage agents</span>
        </div>
        <div class="audience-card scroll-fade-up">
          <div class="audience-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="1" x2="12" y2="23"/>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <span>Brokerage owners</span>
        </div>
        <div class="audience-card scroll-fade-up">
          <div class="audience-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <span>Renewal-heavy books</span>
        </div>
        <div class="audience-card scroll-fade-up">
          <div class="audience-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <span>Client-first brokers</span>
        </div>
      </div>

      <p class="audience-note">You don't need new software or training. You just need your clients to arrive ready.</p>
    </div>
  </section>

  <!-- Privacy -->
  <section class="section section-gradient">
    <div class="container">
      <div class="privacy-layout">
        <div class="privacy-visual scroll-scale">
          <div class="shield-container">
            <div class="shield-ring ring-1"></div>
            <div class="shield-ring ring-2"></div>
            <div class="shield-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
            </div>
          </div>
        </div>
        <div class="privacy-content scroll-fade-up">
          <p class="eyebrow">Your Data. Your Control.</p>
          <h2>We take privacy seriously.</h2>
          <ul class="privacy-list">
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              The client controls what's shared, item by item
            </li>
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              No custodial data — only what's shared for the brief
            </li>
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Hosted in Canada, encrypted storage
            </li>
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Designed around PIPEDA
            </li>
          </ul>
          <p class="privacy-tagline">The client's record belongs to the client.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container">
      <div class="faq-layout">
        <div class="faq-header scroll-fade-up">
          <p class="eyebrow">Questions</p>
          <h2>Frequently Asked<br/>Questions</h2>
        </div>

        <div class="faq-list scroll-fade-up">
          <details class="faq-item" open>
            <summary>
              <span>Does this replace my agents?</span>
              <div class="faq-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="5" x2="12" y2="19"/>
                  <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
              </div>
            </summary>
            <p>No. It prepares the client and hands your agent a two-page brief, so the renewal conversation starts further ahead.</p>
          </details>
          <details class="faq-item">
            <summary>
              <span>Is this licensed mortgage advice?</span>
              <div class="faq-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="5" x2="12" y2="19"/>
